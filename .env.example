# All of these are SERVER-SIDE ONLY. Never prefix with VITE_ (that would expose them to the browser).
# Every variable is optional: with none set, the app runs fully on-device.

# --- Cloud AI: set ONE of these (first one set wins; LLM_PROVIDER can force a choice) -------------
# 1) FREE DeepSeek via OpenRouter (recommended, no card): https://openrouter.ai/keys  -> Create Key
OPENROUTER_API_KEY=
# 2) DeepSeek's own API (pay-as-you-go balance, NOT free): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 3) Gemini (free AI Studio key): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a provider (openrouter | deepseek | gemini) and/or a model name
LLM_PROVIDER=
LLM_MODEL=

# --- Google sign-in -------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your site origins (http://localhost:5173 and your Vercel URL) to "Authorized JavaScript origins".
# The client ID is public by design; there is no client secret in this flow.
GOOGLE_CLIENT_ID=
# Random string, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- Turso (libSQL) storage -----------------------------------------------------------------------
# Turso dashboard > your "chatcheat" database. The URL starts with libsql://
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
