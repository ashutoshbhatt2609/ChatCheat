# All of these are SERVER-SIDE ONLY. Never prefix with VITE_ (that would expose them to the browser).

# Cloud AI (free key, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Default tries gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add your site origin (e.g. http://localhost:5173 and https://your-app.vercel.app) to "Authorized JavaScript origins".
# The client ID is public by design; there is no client secret in this flow.
GOOGLE_CLIENT_ID=

# Random string, at least 32 characters, used to sign session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=

# Turso (libSQL) storage: turso db create chatcheat && turso db show chatcheat --url && turso db tokens create chatcheat
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
